# =============================================================================
# SiteMedic AI — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
#
# Required for AI-powered repair features:
#   1. Sign up at https://studio.nebius.com or https://tokenfactory.nebius.com
#   2. Create an API key in your account settings
#   3. Set NEBIUS_API_KEY below
#
# The application works without the API key — deterministic scanning and
# demo mode are fully functional. AI repair requires the key.
# =============================================================================

# Nebius Token Factory API key (required for AI repair features)
NEBIUS_API_KEY=your-nebius-api-key-here

# Nebius API base URL (default is Token Factory endpoint)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# NVIDIA Nemotron model to use for code analysis and repair
# Available models: nvidia/Nemotron-3.5-Super, nvidia/Nemotron-3-Lightning
NEBIUS_MODEL=nvidia/Nemotron-3.5-Super

# Maximum pages to crawl per live-site scan (default: 10)
SCAN_MAX_PAGES=10

# Maximum ZIP upload size in bytes (default: 50MB)
UPLOAD_MAX_BYTES=52428800

# Max extracted ZIP size in bytes (default: 200MB)
UPLOAD_MAX_EXTRACTED_BYTES=209715200

# Maximum files in uploaded ZIP (default: 500)
UPLOAD_MAX_FILES=500

# Request timeout in milliseconds for live scans (default: 30s)
SCAN_TIMEOUT_MS=30000

# Max redirects to follow during live scan (default: 5)
SCAN_MAX_REDIRECTS=5

# Next.js public URL (set for deployment)
NEXT_PUBLIC_APP_URL=http://localhost:3000
